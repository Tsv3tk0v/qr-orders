# Връзка на приложението: роля qr_app, без права да заобикаля RLS
DATABASE_URL=postgres://qr_app:qr_app@localhost:5432/qr
# Връзка за миграции: собственик на таблиците
MIGRATION_DATABASE_URL=postgres://qr:qr@localhost:5432/qr
# Тестова база (изтрива се и се създава наново при всеки тест)
TEST_DATABASE_URL=postgres://qr_app:qr_app@localhost:5432/qr_test
TEST_MIGRATION_DATABASE_URL=postgres://qr:qr@localhost:5432/qr_test
QR_TOKEN_SECRET=change-me
CONTACT_HASH_KEY=change-me
# Ключ за криптиране на тайни (2FA): openssl rand -base64 32
SECRETS_KEY=
# Само за локална разработка по http: INSECURE_COOKIES=1
BASE_DOMAIN=example.bg
# SFTP импорт: <IMPORT_ROOT>/<бизнес>/{import,history,errors}
IMPORT_ROOT=/srv/sftp
IMPORT_INTERVAL_MIN=15
IMPORT_HOURS=06-22
